# infrastructure/docker/Dockerfile.service
# Многоэтапная сборка микросервисов Spring Boot 4 / Kotlin с поддержкой proto и shared контекста
FROM azul/zulu-openjdk:21@sha256:f233350f4d4f0e7cbd3631694a4239fd237e6633487a566ddaeb3fbcccafaa3b AS builder

WORKDIR /workspace

# Копирование сборочных скриптов и манифестов Gradle
COPY gradlew settings.gradle.kts build.gradle.kts gradle.properties ./
COPY gradle/ gradle/

# Обязательное копирование контекста proto/ и shared/ (требуются для кодогенерации protobuf и :shared:contracts)
COPY proto/ proto/
COPY shared/ shared/
COPY backend/ backend/
COPY shared/contracts/ shared/contracts/
COPY proto/ proto/

RUN chmod +x gradlew

ARG SERVICE_NAME

# Сборка bootJar целевого сервиса с кэшированием Gradle зависимостей
RUN --mount=type=cache,target=/root/.gradle,sharing=locked \
    ./gradlew \
    --no-daemon \
    --max-workers=2 \
    -PbackendOnly=true \
    -Pkotlin.compiler.execution.strategy=in-process \
    "-Dorg.gradle.jvmargs=-Xmx1536m -Dfile.encoding=UTF-8" \
    ":backend:${SERVICE_NAME}:clean" \
    ":backend:${SERVICE_NAME}:bootJar" \
    && mkdir -p /out \
    && cp "backend/${SERVICE_NAME}/build/libs/"*.jar /out/app.jar

# ── Runtime Stage ─────────────────────────────────────────────────────────────
FROM azul/zulu-openjdk:21-jre@sha256:c7cc727a2b13c7018f238c2e113f72fa7744fed8143321ecbb5b6c0d1193ff53 AS runtime

# Создание непривилегированного пользователя app с фиксированным UID/GID 10001
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --no-create-home app

WORKDIR /app

COPY --from=builder --chown=app:app /out/app.jar app.jar

USER app

# 9090 - gRPC Server, 8080 - HTTP Actuator Probes/Metrics
EXPOSE 9090 8080

ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0", "-Dfile.encoding=UTF-8", "-jar", "/app/app.jar"]
